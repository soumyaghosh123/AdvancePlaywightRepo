{
  "compilerOptions": {
    "target": "ES2022",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "strict": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["node"],
    "paths": {
      "@core/*": ["./src/core/*"],
      "@app/*": ["./src/app/*"]
    }
  },
  "include": ["src", "tests", "scripts", "*.ts"]
}
