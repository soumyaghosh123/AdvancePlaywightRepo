{
  "name": "playwrightframework",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "test": "bddgen && playwright test",
    "test:unit": "playwright test -c playwright.unit.config.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "bddgen": "bddgen",
    "test:web": "bddgen && playwright test --grep-invert @api",
    "test:api": "bddgen && playwright test --project=api",
    "test:failed": "bddgen && playwright test --last-failed",
    "test:debug": "bddgen && playwright test --debug --project=chromium",
    "codegen": "playwright codegen",
    "report:open": "playwright show-report reports/playwright",
    "report:allure": "allure open reports/allure-report",
    "report:allure:generate": "allure generate reports/allure-results --clean",
    "report:cucumber": "tsx scripts/open-cucumber-report.ts",
    "locators:check": "tsx scripts/locators-check.ts",
    "steps:list": "bddgen export",
    "generate": "plop",
    "lint:gherkin": "gherkin-lint features",
    "clean:samples": "tsx scripts/clean-samples.ts",
    "prepare": "husky"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "private": "true",
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@faker-js/faker": "^10.6.0",
    "@playwright/test": "^1.64.1",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "csv-parse": "^7.0.3",
    "date-fns": "^4.4.0",
    "dotenv": "^18.0.9",
    "exceljs": "^4.4.0",
    "fast-xml-parser": "^5.11.2",
    "jsonpath-plus": "^11.2.2",
    "pino": "^10.4.0",
    "playwright-bdd": "^9.2.1",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "allure": "^3.22.1",
    "allure-playwright": "^3.14.0",
    "eslint": "^10.13.0",
    "eslint-plugin-playwright": "^2.12.1",
    "gherkin-lint": "^4.2.4",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "plop": "^4.0.5",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1"
  },
  "lint-staged": {
    "*.ts": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.feature": [
      "gherkin-lint"
    ]
  }
}
